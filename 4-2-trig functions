<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Trig Identity Flashcards</title>
<style>
:root{font-family:system-ui,sans-serif;color:#18243d;background:#eef3fa}*{box-sizing:border-box}body{margin:0;padding:24px}main{max-width:850px;margin:auto}h1{font-size:clamp(1.6rem,4vw,2.3rem);margin:0 0 8px}p{line-height:1.5}.subtitle{color:#52617b;margin-top:0}.toolbar,.actions,.nav{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin:18px 0}label{font-weight:600}select,button{font:inherit;padding:12px 16px;border:1px solid #b9c7da;border-radius:10px;background:white;color:#18243d;cursor:pointer}button:hover{background:#e5edf9}button:focus-visible,select:focus-visible{outline:3px solid #d07800;outline-offset:3px}button:disabled{opacity:.45;cursor:default}.primary{background:#284cb5;color:white;border-color:#284cb5}.primary:hover{background:#1c398e}.card{width:100%;min-height:280px;background:white;border:2px solid #c9d6ea;box-shadow:0 10px 30px #23365912;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px;gap:24px}.card:hover{background:#fff}.tag{font-size:.9rem;letter-spacing:.07em;text-transform:uppercase;color:#53637c}.formula{font-family:Georgia,serif;font-size:clamp(2rem,6vw,3.5rem);display:flex;align-items:center;gap:15px}.frac{display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;line-height:1.2}.frac>span:first-child{border-bottom:2px solid currentColor;padding:0 8px 5px}.frac>span:last-child{padding:5px 8px 0}.hint{font-size:1rem;color:#5a6880}.nav{justify-content:space-between}.actions{justify-content:center}.good{background:#e2f5ed;border-color:#71b79a}.missed{background:#fff0df;border-color:#daaa6b}.status{color:#52617b}.note{font-size:.9rem;color:#52617b}footer{margin-top:25px;border-top:1px solid #ccd7e7;padding-top:14px} @media(max-width:500px){body{padding:16px}.card{min-height:260px}.toolbar select{width:100%}.toolbar label{width:100%}}
</style></head><body><main>
<h1>Trig Identity Flashcards</h1><p class="subtitle">Complete the identity, then flip the card to check your answer.</p>
<div class="toolbar"><label for="group">Practice:</label><select id="group"><option value="all">All 8 identities</option><option value="reciprocal">Reciprocal identities (6)</option><option value="quotient">Quotient identities (2)</option></select><button id="shuffle">Shuffle</button><button id="review">Practice missed cards</button><button id="reset">Start over</button></div>
<div class="nav"><button id="prev" aria-label="Previous card">← Previous</button><span id="progress" role="status"></span><button id="next" aria-label="Next card">Next →</button></div>
<button class="card" id="card" aria-label="Flip flashcard"><span class="tag" id="category"></span><span class="formula" id="formula"></span><span class="hint" id="hint"></span></button>
<div class="actions"><button class="primary" id="flip">Show answer</button><button class="missed" id="again" disabled>Practice again</button><button class="good" id="know" disabled>Got it!</button></div>
<p class="status" id="score" aria-live="polite"></p>
<p class="note">These identities hold wherever both sides are defined. In particular, denominators cannot equal zero.</p>
<footer class="note">Keyboard: Space to flip; ← / → to move. After revealing an answer, press 1 for “Practice again” or 2 for “Got it!”</footer>
</main><script>
const fraction=(a,b)=>`<span class="frac"><span>${a}</span><span>${b}</span></span>`;
const cards=[
{lhs:'sin',num:'1',den:'csc',type:'reciprocal'},
{lhs:'csc',num:'1',den:'sin',type:'reciprocal'},
{lhs:'cos',num:'1',den:'sec',type:'reciprocal'},
{lhs:'sec',num:'1',den:'cos',type:'reciprocal'},
{lhs:'tan',num:'1',den:'cot',type:'reciprocal'},
{lhs:'cot',num:'1',den:'tan',type:'reciprocal'},
{lhs:'tan',num:'sin',den:'cos',type:'quotient'},
{lhs:'cot',num:'cos',den:'sin',type:'quotient'}];
let deck=cards.map((_,i)=>i),position=0,revealed=false,ratings={},reviewing=false;
const $=id=>document.getElementById(id);
const term=f=>f==='1'?'1':`${f} <i>t</i>`;
function render(){const id=deck[position],c=cards[id];$('category').textContent=c.type+' identity';$('formula').innerHTML=`<span>${term(c.lhs)}</span><span>=</span>`+(revealed?fraction(term(c.num),term(c.den)):'<span>?</span>');$('hint').textContent=revealed?'Click to hide the answer':'Click to reveal the answer';$('card').setAttribute('aria-label',`${c.type} identity: ${c.lhs} t equals ${revealed?(c.num==='1'?'1':c.num+' t')+' divided by '+c.den+' t':'what? Click to reveal'}`);$('flip').textContent=revealed?'Hide answer':'Show answer';$('again').disabled=$('know').disabled=!revealed;$('prev').disabled=position===0;$('next').disabled=position===deck.length-1;$('progress').textContent=`${reviewing?'Missed cards · ':''}Card ${position+1} of ${deck.length}`;const relevant=cards.map((c,i)=>({c,i})).filter(({c})=>$('group').value==='all'||c.type===$('group').value);const known=relevant.filter(({i})=>ratings[i]==='known').length,missed=relevant.filter(({i})=>ratings[i]==='missed').length;$('score').textContent=`Got it: ${known} · Practice again: ${missed} · Unmarked: ${relevant.length-known-missed}`;$('review').disabled=missed===0;}
function flip(){revealed=!revealed;render()}
function move(n){position=Math.max(0,Math.min(deck.length-1,position+n));revealed=false;render()}
function build(){deck=cards.map((c,i)=>({c,i})).filter(({c})=>$('group').value==='all'||c.type===$('group').value).map(({i})=>i);position=0;revealed=false;reviewing=false;render()}
function rate(value){if(!revealed)return;ratings[deck[position]]=value;if(position<deck.length-1){position++;revealed=false}render()}
$('card').onclick=$('flip').onclick=flip;$('prev').onclick=()=>move(-1);$('next').onclick=()=>move(1);$('group').onchange=build;
$('shuffle').onclick=()=>{for(let i=deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]]}position=0;revealed=false;render()};
$('review').onclick=()=>{deck=cards.map((c,i)=>({c,i})).filter(({c,i})=>ratings[i]==='missed'&&($('group').value==='all'||c.type===$('group').value)).map(({i})=>i);position=0;revealed=false;reviewing=true;render()};
$('reset').onclick=()=>{ratings={};build()};$('again').onclick=()=>rate('missed');$('know').onclick=()=>rate('known');
document.addEventListener('keydown',e=>{if(e.target.matches('select,input,textarea')||e.altKey||e.ctrlKey||e.metaKey)return;if(e.code==='Space'){if(e.target.tagName==='BUTTON')return;e.preventDefault();flip()}else if(e.key==='ArrowLeft'){e.preventDefault();move(-1)}else if(e.key==='ArrowRight'){e.preventDefault();move(1)}else if(e.key==='1')rate('missed');else if(e.key==='2')rate('known')});render();
</script></body></html>
